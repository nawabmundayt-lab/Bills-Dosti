    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"i18n/**/*.ts\" \"messages/*.json\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{ts,mjs,json}\""
  },
