    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "next-intl": "^4.13.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
