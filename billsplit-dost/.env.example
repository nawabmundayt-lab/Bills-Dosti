# ─── BillSplit Dost environment ───────────────────────────────
# Copy to .env.local and fill in. Until configured, the app runs in DEMO MODE.

# Firebase Web app config (Phase 3 — create project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FCM Web Push (Phase 4 M5) — Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FCM_VAPID_KEY=

# Sentry (Phase 4) — optional
NEXT_PUBLIC_SENTRY_DSN=

# ─── Phase 5 — Pro subscription checkout ──────────────────────────────
# PK: Safepay hosted checkout (sandbox.safepay.pk)
NEXT_PUBLIC_SAFEPAY_ENV=sandbox          # sandbox | production
SAFEPAY_API_KEY=                         # server-side session creation
SAFEPAY_WEBHOOK_SECRET=                  # HMAC verification of webhooks

# IN: Razorpay Checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=             # dashboard.razorpay.com → test keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                 # HMAC verification of webhooks

# Phase 7 — TWA Digital Asset Links fingerprint (only used by Android tooling)
# ANDROID_SHA256_FINGERPRINT=
